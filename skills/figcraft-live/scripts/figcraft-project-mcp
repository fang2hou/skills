#!/usr/bin/env bash
# Register (or remove) the `figcraft` MCP server at project level, so only
# sessions started in that project launch the FigCraft app.
#
# Usage: figcraft-project-mcp [--client omp|claude] [--remove] [PROJECT_DIR]
#   omp    -> PROJECT_DIR/.omp/mcp.json  (default)
#   claude -> PROJECT_DIR/.mcp.json
set -euo pipefail

client=omp
remove=0
dir=.

while [ $# -gt 0 ]; do
  case "$1" in
    --client)
      [ $# -ge 2 ] || { echo "figcraft-project-mcp: --client needs omp or claude" >&2; exit 2; }
      client="$2"
      shift 2
      ;;
    --remove) remove=1; shift ;;
    -h | --help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "figcraft-project-mcp: unknown option $1" >&2; exit 2 ;;
    *) dir="$1"; shift ;;
  esac
done

case "$client" in
  omp) rel=.omp/mcp.json ;;
  claude) rel=.mcp.json ;;
  *) echo "figcraft-project-mcp: unknown client '$client' (omp or claude)" >&2; exit 2 ;;
esac

command -v jq >/dev/null 2>&1 || { echo "figcraft-project-mcp: jq is required" >&2; exit 127; }
[ -d "$dir" ] || { echo "figcraft-project-mcp: $dir is not a directory" >&2; exit 2; }
dir="$(cd "$dir" && pwd -P)"
file="$dir/$rel"

# Absolute path: GUI-launched clients do not inherit the shell PATH.
wrapper="$HOME/.local/bin/figcraft-live-mcp"

write_json() {
  local tmp
  tmp="$(mktemp "$file.XXXXXX")"
  if jq "$@" "$file" >"$tmp"; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    exit 1
  fi
}

if [ "$remove" -eq 1 ]; then
  if [ ! -f "$file" ]; then
    echo "figcraft-project-mcp: nothing to remove ($file missing)"
    exit 0
  fi
  write_json 'del(.mcpServers.figcraft)'
  if jq -e '(.mcpServers // {}) == {} and ([keys[] | select(. != "mcpServers" and . != "$schema")] | length) == 0' "$file" >/dev/null; then
    rm -f "$file"
    [ "$client" = omp ] && rmdir "$dir/.omp" 2>/dev/null || true
  fi
  echo "figcraft-project-mcp: removed figcraft from $file"
  exit 0
fi

[ -x "$wrapper" ] || {
  echo "figcraft-project-mcp: $wrapper missing; install it first (install -m 755 <skill-dir>/scripts/figcraft-live-mcp ~/.local/bin/)" >&2
  exit 1
}

mkdir -p "$(dirname "$file")"
[ -f "$file" ] || printf '{}\n' >"$file"
write_json --arg cmd "$wrapper" '.mcpServers = ((.mcpServers // {}) + {figcraft: {command: $cmd}})'

# The entry holds a machine-specific absolute path: keep it out of commits.
if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  top="$(git -C "$dir" rev-parse --show-toplevel)"
  if git -C "$dir" ls-files --error-unmatch "$rel" >/dev/null 2>&1; then
    echo "figcraft-project-mcp: warning: $rel is tracked by git; the figcraft entry holds $wrapper, so do not commit that change" >&2
  else
    exclude="$(git -C "$dir" rev-parse --path-format=absolute --git-path info/exclude)"
    pattern="/${dir#"$top"/}/$rel"
    [ "$dir" = "$top" ] && pattern="/$rel"
    mkdir -p "$(dirname "$exclude")"
    grep -qxF "$pattern" "$exclude" 2>/dev/null || printf '%s\n' "$pattern" >>"$exclude"
  fi
fi

echo "figcraft-project-mcp: registered figcraft in $file"
case "$client" in
  omp) echo "next: run /mcp reload in omp (project config is discovered on reload)" ;;
  claude) echo "next: restart Claude Code in this project and approve the figcraft server" ;;
esac
